{
  "Dashboard": {
    "Port": 5057,
    "RepositoryRoot": "../..",
    "DataDirectory": "../.data",
    "HistoryRunsPerLab": 30,
    "Reporting": {
      "ServerUrl": "https://labs-admin-dash.vercel.app",
      "HeartbeatSeconds": 60,
      "FlushIntervalSeconds": 5,
      "RequestTimeoutSeconds": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.Hosting.Lifetime": "Warning",
      "LabDashboard": "Information"
    }
  }
