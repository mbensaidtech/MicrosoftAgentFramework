<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>LabDashboard</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Renders the lab README files (Markdown) to HTML, with raw HTML disabled. -->
    <PackageReference Include="Markdig" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Built and copied next to the dashboard; loaded only into the process of interactive labs (never into the dashboard). -->
    <ProjectReference Include="..\LabInputHook\LabInputHook.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The scenario selection rules of the labs (CommonUtilities): the dashboard compiles the same file, it never has its own copy. -->
    <Compile Include="..\..\CommonUtilities\LabScenarios.cs" Link="Catalog\LabScenarios.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LabDashboard.Tests" />
  </ItemGroup>

</Project>
