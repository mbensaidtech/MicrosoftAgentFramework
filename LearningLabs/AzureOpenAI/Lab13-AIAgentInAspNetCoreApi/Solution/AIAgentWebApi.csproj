<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Shared by every lab: set your Azure OpenAI secrets once with `dotnet user-secrets`. -->
    <UserSecretsId>microsoft-agent-framework-learninglabs</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- ASP.NET Core: WebApplication, minimal APIs, authentication, Server-Sent Events results. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <!-- Agent Framework + OpenAI integration (brings OpenAI and Microsoft.Extensions.AI transitively). -->
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.26.0" />
    <!-- Streaming fix: Agent Framework 1.26.0 still brings Microsoft.Extensions.AI.OpenAI 10.10.x, whose streaming fails on the
         annotation chunks without "delta" that Azure sends when the deployment uses the asynchronous content filter
         (dotnet/extensions#7790). 10.11.0 fixes it (and brings OpenAI 2.14.0). The API streams every answer. -->
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
    <!-- JWT bearer authentication of the API (brings Microsoft.IdentityModel.JsonWebTokens, used by the development token issuer). -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.14" />
    <!-- DefaultAzureCredential for Microsoft Entra ID authentication. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\CommonUtilities\CommonUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
