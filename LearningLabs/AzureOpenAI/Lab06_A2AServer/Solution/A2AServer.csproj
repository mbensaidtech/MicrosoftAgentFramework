<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Shared by every lab: set your Azure OpenAI secrets once with `dotnet user-secrets`. -->
    <UserSecretsId>microsoft-agent-framework-learninglabs</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Agent Framework + OpenAI integration (brings OpenAI and Microsoft.Extensions.AI transitively). -->
    <PackageReference Include="Microsoft.Agents.AI.OpenAI" Version="1.22.0" />
    <!-- A2A hosting for ASP.NET Core: AddA2AServer, MapA2AJsonRpc, MapA2AHttpJson (brings the A2A SDK v1, A2A.AspNetCore
         and Microsoft.Extensions.Configuration.* 10.0.12 transitively). No stable version exists yet: the preview aligned on 1.22.0 is used. -->
    <PackageReference Include="Microsoft.Agents.AI.Hosting.A2A.AspNetCore" Version="1.22.0-preview.260918.1" />
    <!-- DefaultAzureCredential for Microsoft Entra ID authentication. -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\..\CommonUtilities\CommonUtilities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
